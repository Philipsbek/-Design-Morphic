---
const cols = [
  {
    title: 'Product',
    links: ['Canvas', 'Copilot', 'Compose', 'Sakura engine', 'Pricing'],
  },
  {
    title: 'Genres',
    links: ['Shounen', 'Shoujo', 'Mecha', 'Slice of life', 'Isekai'],
  },
  {
    title: 'Resources',
    links: ['Showcase', 'Prompt guide', 'Character sheets', 'API docs', 'Status'],
  },
  {
    title: 'Company',
    links: ['About', 'Careers', 'Blog', 'Privacy', 'Terms'],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="#top" class="brand" aria-label="Morphic home">
          <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
            <path
              d="M6 24V9l10 8 10-8v15"
              fill="none"
              stroke="#0075ff"
              stroke-width="2.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>Morphic</span>
        </a>
        <p>Type a scene. Watch it become anime.</p>
        <a href="#pricing" class="btn btn-primary">Start for free</a>
      </div>

      <div class="footer-cols">
        {
          cols.map((c) => (
            <div class="footer-col">
              <h4>{c.title}</h4>
              <ul>
                {c.links.map((l) => (
                  <li>
                    <a href="#">{l}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="footer-bottom">
      <span>© 2026 Morphic Labs, Inc. All rights reserved.</span>
      <div class="footer-social">
        <a href="#" aria-label="X">X</a>
        <a href="#" aria-label="YouTube">YouTube</a>
        <a href="#" aria-label="Discord">Discord</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--border-hairline);
    padding-block: var(--spacing-72) var(--spacing-40);
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: var(--spacing-60);
    padding-bottom: var(--spacing-60);
  }
  .footer-brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--spacing-16);
  }
  .footer-brand .brand span {
    color: var(--color-paper-white);
    font-size: var(--text-heading-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.44px;
  }
  .footer-brand p {
    color: var(--color-mid-gray);
    margin-bottom: var(--spacing-20);
    max-width: 260px;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-24);
  }
  .footer-col h4 {
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-paper-white);
    margin-bottom: var(--spacing-16);
    letter-spacing: -0.1px;
  }
  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }
  .footer-col a {
    font-size: 13px;
    color: var(--color-steel);
    transition: color 0.18s ease;
  }
  .footer-col a:hover {
    color: var(--color-paper-white);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--spacing-24);
    border-top: var(--border-hairline);
    font-size: 12px;
    color: var(--color-graphite);
    flex-wrap: wrap;
    gap: var(--spacing-16);
  }
  .footer-social {
    display: flex;
    gap: var(--spacing-20);
  }
  .footer-social a {
    color: var(--color-steel);
    transition: color 0.18s ease;
  }
  .footer-social a:hover {
    color: var(--color-paper-white);
  }

  @media (max-width: 860px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--spacing-40);
    }
    .footer-cols {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-32);
    }
  }
</style>
