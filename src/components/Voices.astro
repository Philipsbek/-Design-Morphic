---
import AnimeAvatar from './AnimeAvatar.astro';

const stats = [
  { value: '62M+', label: 'frames animated' },
  { value: '140k', label: 'creators' },
  { value: '25s', label: 'to first key visual' },
  { value: '4K', label: 'cel-shaded output' },
];

const quotes = [
  {
    body: '“We pitched a full episode with animated key art in a weekend. Our producer thought we had a studio behind us.”',
    name: 'Rina Takahashi',
    role: 'Director, Studio Hoshi',
    v: 5,
  },
  {
    body: '“Copilot keeps my character on-model across every cut. That was the wall doujin artists could never climb.”',
    name: 'Kenji Mori',
    role: 'Doujin creator',
    v: 12,
  },
  {
    body: '“Backgrounds used to eat my whole week. Now I describe the sky and it paints Shinkai for me.”',
    name: 'Aoi Sato',
    role: 'Background artist',
    v: 27,
  },
];
---

<section class="section voices">
  <div class="container">
    <div class="stats" data-reveal>
      {
        stats.map((s) => (
          <div class="stat">
            <div class="stat-value">{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))
      }
    </div>

    <div class="quotes">
      {
        quotes.map((q, i) => (
          <figure class="quote" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <blockquote>{q.body}</blockquote>
            <figcaption>
              <AnimeAvatar v={q.v} size={32} class="q-av" />
              <span>
                <strong>{q.name}</strong>
                <em>{q.role}</em>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-16);
    padding-bottom: var(--spacing-72);
    border-bottom: var(--border-hairline);
    margin-bottom: var(--spacing-72);
  }
  .stat-value {
    font-size: var(--text-heading);
    font-weight: var(--font-weight-bold);
    letter-spacing: -1.9px;
    color: var(--color-paper-white);
    line-height: 1;
  }
  .stat-label {
    margin-top: var(--spacing-8);
    font-size: 12px;
    color: var(--color-mid-gray);
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-16);
  }
  .quote {
    background: var(--surface-card);
    border: var(--border-hairline);
    border-radius: var(--radius-lg);
    padding: var(--spacing-24);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--spacing-24);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .quote:hover {
    border-color: rgba(229, 231, 235, 0.22);
    transform: translateY(-3px);
  }
  blockquote {
    font-size: var(--text-body-lg);
    line-height: 1.45;
    letter-spacing: -0.4px;
    color: var(--color-mist);
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: var(--spacing-12);
  }
  figcaption :global(.q-av) {
    border-radius: 50%;
    flex: 0 0 auto;
  }
  figcaption span {
    display: flex;
    flex-direction: column;
  }
  figcaption strong {
    font-size: var(--text-body);
    font-weight: var(--font-weight-medium);
    color: var(--color-paper-white);
  }
  figcaption em {
    font-size: 12px;
    font-style: normal;
    color: var(--color-mid-gray);
  }

  @media (max-width: 860px) {
    .quotes {
      grid-template-columns: 1fr;
    }
    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-32);
    }
  }
</style>
