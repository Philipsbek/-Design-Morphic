---
/** Small deterministic anime-style character bust used for social proof. */
interface Props {
  v?: number;
  size?: number;
  class?: string;
}
const { v = 0, size = 32, class: cls = '' } = Astro.props;

function mulberry32(a: number) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(Math.imul(v + 7, 40503) ^ 0x85ebca6b);

const bgs = ['#6d2f6b', '#2e6fa3', '#26408f', '#2f8f86', '#b03a5b', '#3a2f7a', '#d98a3d', '#456f4a'];
const hairs = ['#1c1a26', '#3a2418', '#5a2a3a', '#2a3f56', '#7a4a2a', '#4a2a5a', '#b8443a', '#c9a24a'];
const skins = ['#f4d3b8', '#f0c8a8', '#e8bfa0'];

const bg = bgs[Math.floor(rnd() * bgs.length)];
const hair = hairs[Math.floor(rnd() * hairs.length)];
const skin = skins[Math.floor(rnd() * skins.length)];
const style = Math.floor(rnd() * 3); // bang variant
const uid = 'av' + Math.random().toString(36).slice(2, 7);
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={`${uid}-b`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color={bg} />
      <stop offset="100%" stop-color="#0b0713" />
    </linearGradient>
    <clipPath id={`${uid}-c`}><circle cx="32" cy="32" r="32" /></clipPath>
  </defs>
  <g clip-path={`url(#${uid}-c)`}>
    <rect width="64" height="64" fill={`url(#${uid}-b)`} />
    <!-- shoulders -->
    <ellipse cx="32" cy="66" rx="24" ry="18" fill={hair} opacity="0.85" />
    <!-- back hair -->
    <ellipse cx="32" cy="34" rx="21" ry="23" fill={hair} />
    <!-- face -->
    <ellipse cx="32" cy="36" rx="15.5" ry="17" fill={skin} />
    <!-- bangs -->
    {style === 0 && (
      <path d="M16 34 Q18 16 32 15 Q46 16 48 34 Q42 24 32 25 Q22 24 16 34 Z" fill={hair} />
    )}
    {style === 1 && (
      <path d="M16 32 Q17 15 32 14 Q47 15 48 32 Q44 22 38 26 Q35 20 32 26 Q29 20 26 26 Q20 22 16 32 Z" fill={hair} />
    )}
    {style === 2 && (
      <path d="M15 30 Q18 14 32 14 Q46 14 49 30 Q45 20 40 24 L36 18 Q32 24 28 18 L24 24 Q19 20 15 30 Z" fill={hair} />
    )}
    <!-- eyes -->
    <ellipse cx="25.5" cy="38" rx="2.4" ry="3.4" fill="#141019" />
    <ellipse cx="38.5" cy="38" rx="2.4" ry="3.4" fill="#141019" />
    <circle cx="26.2" cy="37" r="0.9" fill="#fff" />
    <circle cx="39.2" cy="37" r="0.9" fill="#fff" />
    <!-- blush + mouth -->
    <ellipse cx="23" cy="43" rx="2.4" ry="1.3" fill="#ff9ab0" opacity="0.5" />
    <ellipse cx="41" cy="43" rx="2.4" ry="1.3" fill="#ff9ab0" opacity="0.5" />
    <path d="M30 45 Q32 47 34 45" stroke="#b06a6a" stroke-width="1.1" fill="none" stroke-linecap="round" />
  </g>
</svg>
